# Required to run the application.
OPENAI_API_KEY=

# Public Hugging Face Dataset that stores the generated runtime artifact.
HF_DATASET_REPOSITORY=cruzdepaula/dane-assistant-artifacts
HF_DATASET_REVISION=main
DATA_VERSION=v1

# Optional local port for Streamlit.
STREAMLIT_PORT=8501

# Required only by the explicit `publisher` profile. Keep this secret in .env.
HF_TOKEN=
